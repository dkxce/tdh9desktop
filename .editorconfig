# EditorConfig: force UTF-8 encoding so all editors/IDEs read the sources
# uniformly (Russian comments stay readable regardless of the local codepage).
# Dirs: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,md,json,txt}]
charset = utf-8